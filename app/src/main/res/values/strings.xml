    <string name="settings_title">Settings</string>
    <string name="settings_pacing_title">Pacing</string>
    <string name="settings_pacing_body">Slow downloads down so that websites are less likely to block you.</string>
    <string name="option_sleep_request_title">Wait between requests</string>
    <string name="option_sleep_request_body">Pause between requests to a website. Enter seconds as one number or as a range, for example 2.0-4.0.</string>
    <string name="option_sleep_title">Wait between downloads</string>
    <string name="option_sleep_body">Pause before each file is downloaded. Enter seconds as one number or as a range, for example 2.0-4.0.</string>
    <string name="option_seconds_label">Seconds</string>
    <string name="error_duration">Please enter seconds from 0 to 300, as one number or a range such as 2.0-4.0.</string>
